# ---------------------------------------------------------------------------
# All variables here are OPTIONAL. The site builds and runs without any of them;
# features that need a key degrade gracefully instead of erroring.
# ---------------------------------------------------------------------------

# Groq API key — powers the "Chunks" chat widget (/api/chat).
# Get a free key at https://console.groq.com/keys
# Free tier: 30 requests/minute, 14,400 requests/day.
# Unset -> the widget replies with a canned offline message.
GROQ_API_KEY=

# Optional Groq model override. Groq retires models periodically and a retired id
# fails at request time with a 404. List what your key can reach with:
#   curl https://api.groq.com/openai/v1/models -H "Authorization: Bearer $GROQ_API_KEY"
# Unset -> openai/gpt-oss-120b
GROQ_MODEL=

# Resend API key — powers the contact form (/api/contact).
# Get a key at https://resend.com/api-keys
# Unset -> the form falls back to opening the visitor's mail client (mailto:).
RESEND_API_KEY=

# From-address for contact form emails. Must be on a domain you have verified at
# https://resend.com/domains. A free-mail address (gmail.com, outlook.com, ...)
# will NOT work here and fails with a 403 "domain is not verified" — you cannot
# verify a domain you don't own. This is the SENDER, not the recipient; the
# recipient is contactInfo.email in lib/data.ts.
#
# Leave as onboarding@resend.dev to use Resend's shared test sender. That sender
# can only deliver to the address that owns the Resend account, which is fine
# while the recipient is your own inbox, but means messages from real visitors
# will be rejected until you verify a domain.
CONTACT_FROM_EMAIL=onboarding@resend.dev

# Canonical public URL, used for OG/Twitter metadata and sitemap-style absolute
# links. No trailing slash. Defaults to https://christian-digital-portfolio.vercel.app
NEXT_PUBLIC_SITE_URL=
